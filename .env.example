# 旅行RPG · 城市拾遗 —— 环境变量样例
# 复制为 .env 并填入真实值：cp .env.example .env   （.env 已被 .gitignore 排除，切勿提交）

# 阿里云百炼 API Key（百炼控制台 -> API-KEY 页创建，明文仅显示一次）
BAILIAN_API_KEY=

# 飞猪 FlyAI 开放平台 Key（https://flyai.open.fliggy.com/ 申请）
FLYAI_API_KEY=

# 百炼托管 Agent 相关资源 ID（替换成你自己的；留空则用代码内默认）
WORKSPACE_ID=
AGENT_ID=
ENV_ID=

# 服务端口（默认 8788）
PORT=8788

# 访问口令：留空=不鉴权（游客名字直接进入）；设为任意字符串则开启口令门槛
ACCESS_KEY=
